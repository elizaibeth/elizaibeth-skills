<?php
declare(strict_types=1);

namespace {{ namespacePrefix }}\Http\Controllers;

use {{ namespacePrefix }}\Http\Requests\Create{{ PascalCaseModelName }}Request;
use {{ namespacePrefix }}\Http\Requests\Update{{ PascalCaseModelName }}Request;
use {{ namespacePrefix }}\Models\{{ PascalCaseModelName }};
use Illuminate\Contracts\View\View;
use Illuminate\Http\RedirectResponse;
use Illuminate\Routing\Controllers\HasMiddleware;
use Illuminate\Support\Facades\Gate;

class {{ PascalCaseModelName }}Controller extends Controller implements HasMiddleware
{
    public static function middleware(): array
    {
        return ['auth'];
    }

    public function index(): View
    {
        Gate::authorize('viewAny', {{ PascalCaseModelName }}::class);

        // Apply ownership/tenant query scopes here when the resource requires them.
        $records = {{ PascalCaseModelName }}::query()->latest('id')->paginate(15)->withQueryString();

        return view('{{ lowerCaseModelNameToDir }}.index', compact('records'));
    }

    public function create(): View
    {
        Gate::authorize('create', {{ PascalCaseModelName }}::class);

        return view('{{ lowerCaseModelNameToDir }}.create');
    }

    public function store(Create{{ PascalCaseModelName }}Request $request): RedirectResponse
    {
        Gate::authorize('create', {{ PascalCaseModelName }}::class);
        {{ PascalCaseModelName }}::create($request->validated());

        return to_route('{{ webRouteName }}.index')->with('status', '{{ singularName }} created.');
    }

    public function show(string $id): View
    {
        $record = {{ PascalCaseModelName }}::findOrFail($id);
        Gate::authorize('view', $record);

        return view('{{ lowerCaseModelNameToDir }}.show', compact('record'));
    }

    public function edit(string $id): View
    {
        $record = {{ PascalCaseModelName }}::findOrFail($id);
        Gate::authorize('update', $record);

        return view('{{ lowerCaseModelNameToDir }}.edit', compact('record'));
    }

    public function update(Update{{ PascalCaseModelName }}Request $request, string $id): RedirectResponse
    {
        $record = {{ PascalCaseModelName }}::findOrFail($id);
        Gate::authorize('update', $record);
        $record->update($request->validated());

        return to_route('{{ webRouteName }}.index')->with('status', '{{ singularName }} updated.');
    }

    public function destroy(string $id): RedirectResponse
    {
        $record = {{ PascalCaseModelName }}::findOrFail($id);
        Gate::authorize('delete', $record);
        $record->delete();

        return to_route('{{ webRouteName }}.index')->with('status', '{{ singularName }} deleted.');
    }
}
